// Procedural 64x4 S04 floor tile. Decorative strokes are top-layer only.

// Solid dark industrial slab.
BOX FSTORE:BRUSH
MAT_GUNMETAL_3 FSTORE:MATERIAL
0 0 0 VEC VSTORE:START
63 3 63 VEC VSTORE:END
STROKE

// Restrict the remaining work to the exposed top voxel layer.
0 3 0 VEC VSTORE:CLIP_MIN
63 3 63 VEC VSTORE:CLIP_MAX

// Neutral charcoal outer lip, dark recess and concrete panel field.
MAT_CONCRETE_1 FSTORE:MATERIAL
0 3 0 VEC VSTORE:START
63 3 63 VEC VSTORE:END
STROKE
MAT_CONCRETE_0 FSTORE:MATERIAL
3 3 3 VEC VSTORE:START
60 3 60 VEC VSTORE:END
STROKE
MAT_CONCRETE_3 FSTORE:MATERIAL
5 3 5 VEC VSTORE:START
58 3 58 VEC VSTORE:END
STROKE

// Deep center seams split the surface into four panels.
MAT_CONCRETE_0 FSTORE:MATERIAL
31 3 5 VEC VSTORE:START
32 3 58 VEC VSTORE:END
STROKE
5 3 31 VEC VSTORE:START
58 3 32 VEC VSTORE:END
STROKE


// Subtle grime and diagonal abrasion inside one panel.
CAPSULE FSTORE:BRUSH
1 FSTORE:RADIUS
MAT_CONCRETE_2 FSTORE:MATERIAL
11 3 12 VEC VSTORE:START
25 3 26 VEC VSTORE:END
STROKE
15 3 9 VEC VSTORE:START
29 3 23 VEC VSTORE:END
STROKE
10 3 23 VEC VSTORE:START
17 3 30 VEC VSTORE:END
STROKE

MAT_CONCRETE_6 FSTORE:MATERIAL
12 3 27 VEC VSTORE:START
20 3 20 VEC VSTORE:END
STROKE
22 3 14 VEC VSTORE:START
28 3 9 VEC VSTORE:END
STROKE

// Recessed chips and steel fasteners.
SPHERE FSTORE:BRUSH
1 FSTORE:RADIUS
MAT_CONCRETE_1 FSTORE:MATERIAL
14 3 16 VEC VSTORE:START
STROKE
24 3 27 VEC VSTORE:START
STROKE
27 3 13 VEC VSTORE:START
STROKE
MAT_STEEL_1 FSTORE:MATERIAL
4 3 4 VEC VSTORE:START
STROKE
4 3 31 VEC VSTORE:START
STROKE
31 3 4 VEC VSTORE:START
STROKE

// Copy the detailed lower-left quarter across X and Z.
MIRROR:X
MIRROR:Z
