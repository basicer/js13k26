// 64x4 industrial floor cassette. Recesses retain a solid backing.
BOX FSTORE:BRUSH
MAT_GUNMETAL_1 FSTORE:MATERIAL
0 0 0 VEC VSTORE:START
63 2 63 VEC VSTORE:END
STROKE

// Inset perimeter rail leaves a one-voxel joint at each tile edge.
MAT_GUNMETAL_2 FSTORE:MATERIAL
1 3 1 VEC VSTORE:START
62 3 62 VEC VSTORE:END
STROKE
MAT_EMPTY FSTORE:MATERIAL
4 3 4 VEC VSTORE:START
59 3 59 VEC VSTORE:END
STROKE

// One panel, with a stepped corner and a narrow worn bevel.
MAT_CONCRETE_6 FSTORE:MATERIAL
6 3 7 VEC VSTORE:START
29 3 28 VEC VSTORE:END
STROKE
7 3 6 VEC VSTORE:START
28 3 29 VEC VSTORE:END
STROKE
MAT_CONCRETE_9 FSTORE:MATERIAL
7 3 7 VEC VSTORE:START
28 3 28 VEC VSTORE:END
STROKE

// Fine edge wear, kept below the contrast of the surrounding frame.
MAT_CONCRETE_11 FSTORE:MATERIAL
8 3 7 VEC VSTORE:START
24 3 7 VEC VSTORE:END
STROKE
7 3 8 VEC VSTORE:START
7 3 23 VEC VSTORE:END
STROKE

// Countersunk steel screw: dark socket, head and recessed driver slot.
SPHERE FSTORE:BRUSH
2 FSTORE:RADIUS
MAT_GUNMETAL_0 FSTORE:MATERIAL
10 3 10 VEC VSTORE:START
STROKE:PAINT
1 FSTORE:RADIUS
MAT_STEEL_6 FSTORE:MATERIAL
STROKE:PAINT
BOX FSTORE:BRUSH
MAT_EMPTY FSTORE:MATERIAL
9 3 10 VEC VSTORE:START
11 3 10 VEC VSTORE:END
STROKE

// Short grip grooves near the inner panel corner.
23 3 24 VEC VSTORE:START
27 3 24 VEC VSTORE:END
STROKE
23 3 26 VEC VSTORE:START
27 3 26 VEC VSTORE:END
STROKE

// Repeat the manufactured surface geometry.
0 3 0 VEC VSTORE:CLIP_MIN
63 3 63 VEC VSTORE:CLIP_MAX
MIRROR:X
MIRROR:Z

// Sparse, asymmetric scuffs avoid a mirrored wear pattern when tiled.
CAPSULE FSTORE:BRUSH
0 FSTORE:RADIUS
MAT_CONCRETE_7 FSTORE:MATERIAL
15 3 19 VEC VSTORE:START
21 3 25 VEC VSTORE:END
STROKE:PAINT
40 3 13 VEC VSTORE:START
45 3 18 VEC VSTORE:END
STROKE:PAINT
17 3 44 VEC VSTORE:START
20 3 41 VEC VSTORE:END
STROKE:PAINT
MAT_CONCRETE_11 FSTORE:MATERIAL
16 3 19 VEC VSTORE:START
19 3 22 VEC VSTORE:END
STROKE:PAINT
42 3 46 VEC VSTORE:START
47 3 51 VEC VSTORE:END
STROKE:PAINT
