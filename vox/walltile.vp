// Solid steel bulkhead; axis passes preserve the original internal materials.
BOX FSTORE:BRUSH
MAT_STEEL_2 FSTORE:MATERIAL
VLOAD:CLIP_MAX VSTORE:END
STROKE

// Material, two start coordinates, two end coordinates; pop in reverse.
axis2_0: MAT_STEEL_8 54 54 55 55
axis2_1: MAT_STEEL_8 8 54 9 55
axis2_2: MAT_STEEL_8 54 8 55 9
axis2_3: MAT_STEEL_8 8 8 9 9
axis2_4: MAT_CYAN_EMISSIVE_5 49 46 50 51
axis2_5: MAT_GUNMETAL_0 47 44 54 53
axis2_6: MAT_STEEL_2 12 50 40 51
axis2_7: MAT_STEEL_2 12 46 40 47
axis2_8: MAT_GUNMETAL_0 10 44 42 53
axis2_9: MAT_STEEL_4 9 9 54 39
axis2_10: MAT_STEEL_3 7 7 56 56
axis2_11: MAT_STEEL_6 5 5 58 58
axis2_12: MAT_GUNMETAL_0 3 3 60 60
draw2:
FSTORE:3 FSTORE:4 FSTORE:5 FSTORE:6 FSTORE:MATERIAL
FLOAD:6 FLOAD:5 0 VEC VSTORE:START
FLOAD:4 FLOAD:3 63 VEC VSTORE:END
STROKE
FORJUMP draw2
// One repeat keeps the next table aligned for base64/ZIP compression.
STROKE

// Material, two start coordinates, two end coordinates; pop in reverse.
axis0_0: MAT_STEEL_8 54 54 55 55
axis0_1: MAT_STEEL_8 54 8 55 9
axis0_2: MAT_STEEL_8 8 54 9 55
axis0_3: MAT_STEEL_8 8 8 9 9
axis0_4: MAT_CYAN_EMISSIVE_5 46 49 51 50
axis0_5: MAT_GUNMETAL_0 44 47 53 54
axis0_6: MAT_STEEL_2 50 12 51 40
axis0_7: MAT_STEEL_2 46 12 47 40
axis0_8: MAT_GUNMETAL_0 44 10 53 42
axis0_9: MAT_STEEL_4 9 9 39 54
axis0_10: MAT_STEEL_3 7 7 56 56
axis0_11: MAT_STEEL_6 5 5 58 58
axis0_12: MAT_GUNMETAL_0 3 3 60 60
draw0:
FSTORE:3 FSTORE:4 FSTORE:5 FSTORE:6 FSTORE:MATERIAL
0 FLOAD:6 FLOAD:5 VEC VSTORE:START
63 FLOAD:4 FLOAD:3 VEC VSTORE:END
STROKE
FORJUMP draw0
// One repeat keeps the next table aligned for base64/ZIP compression.
STROKE

// Material, two start coordinates, two end coordinates; pop in reverse.
axis1_0: MAT_STEEL_8 54 54 55 55
axis1_1: MAT_STEEL_8 8 54 9 55
axis1_2: MAT_STEEL_8 54 8 55 9
axis1_3: MAT_STEEL_8 8 8 9 9
axis1_4: MAT_CYAN_EMISSIVE_5 49 46 50 51
axis1_5: MAT_GUNMETAL_0 47 44 54 53
axis1_6: MAT_STEEL_2 12 50 40 51
axis1_7: MAT_STEEL_2 12 46 40 47
axis1_8: MAT_GUNMETAL_0 10 44 42 53
axis1_9: MAT_STEEL_4 9 9 54 39
axis1_10: MAT_STEEL_3 7 7 56 56
axis1_11: MAT_STEEL_6 5 5 58 58
axis1_12: MAT_GUNMETAL_0 3 3 60 60
draw1:
FSTORE:3 FSTORE:4 FSTORE:5 FSTORE:6 FSTORE:MATERIAL
FLOAD:6 0 FLOAD:5 VEC VSTORE:START
FLOAD:4 63 FLOAD:3 VEC VSTORE:END
STROKE
FORJUMP draw1
// One repeat keeps the next table aligned for base64/ZIP compression.
STROKE
