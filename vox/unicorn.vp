// Swept forelock frames the face beneath the horn.
MAT_LAVENDER FSTORE:MATERIAL
29 54 47 VEC VSTORE:START
27 52 49 VEC VSTORE:END
STROKE:SWAP
1 FSTORE:RADIUS
MAT_PINK FSTORE:MATERIAL
27 51 51 VEC VSTORE:END
STROKE

// Tail: a continuous cascade with layered colored strands.
4 FSTORE:RADIUS
MAT_PINK FSTORE:MATERIAL
31 34 15 VEC VSTORE:START
29 32 9 VEC VSTORE:END
STROKE:SWAP
28 24 6 VEC VSTORE:END
STROKE:SWAP
3 FSTORE:RADIUS
28 17 10 VEC VSTORE:END
STROKE
2 FSTORE:RADIUS
MAT_LAVENDER FSTORE:MATERIAL
27 33 12 VEC VSTORE:START
25 25 7 VEC VSTORE:END
STROKE:SWAP
26 17 10 VEC VSTORE:END
STROKE
MAT_TURQUOISE FSTORE:MATERIAL
25 30 11 VEC VSTORE:START
24 24 9 VEC VSTORE:END
STROKE:SWAP
26 19 12 VEC VSTORE:END
STROKE

// Golden horn: broad base, slender shaft, bright pointed tip.
2 FSTORE:RADIUS
MAT_GOLD FSTORE:MATERIAL
31 53 51 VEC VSTORE:START
31 56 53 VEC VSTORE:END
STROKE:SWAP
1 FSTORE:RADIUS
MAT_PEACH FSTORE:MATERIAL
31 60 55 VEC VSTORE:END
STROKE:SWAP
MAT_PALE_GOLD FSTORE:MATERIAL
31 61 56 VEC VSTORE:END
STROKE
SPHERE FSTORE:BRUSH
0 FSTORE:RADIUS
MAT_WHITE FSTORE:MATERIAL
31 62 57 VEC VSTORE:START
STROKE

// Surface details: dark eyes, catchlights, blush, subtle nostrils.
2 FSTORE:RADIUS
MAT_INK FSTORE:MATERIAL
26 49 50 VEC VSTORE:START
STROKE:PAINT
1 FSTORE:RADIUS
MAT_CORAL FSTORE:MATERIAL
27 47 53 VEC VSTORE:START
STROKE:PAINT
0 FSTORE:RADIUS
MAT_WHITE FSTORE:MATERIAL
27 50 50 VEC VSTORE:START
STROKE:PAINT
MAT_CHARCOAL FSTORE:MATERIAL
29 45 58 VEC VSTORE:START
STROKE:PAINT
29 43 58 VEC VSTORE:START
STROKE:PAINT

MIRROR:X

// Stack schedule: exit second pass, second pose, exit first pass, first pose.
// Parameter 0 swaps standing/stride between the left and right sides.
LOADP:0 JUMPIF phase_one
1 0 0 1
1 JUMPIF leg_pose
phase_one:
1 1 0 0
leg_pose:
JUMPIF stride
// Coordinates are stacked in reverse draw order for the shared routine.
27 10 43
23 9 40
27 10 25
23 9 22
28 8 45
22 5 39
28 8 27
22 5 21
25 8 41
25 20 41
25 8 23
25 17 21
1 JUMPIF draw_legs
stride:
27 15 48
23 14 45
27 10 21
23 9 18
28 13 50
22 10 44
28 8 23
22 5 17
25 13 46
25 20 44
25 8 19
25 17 19
draw_legs:
CAPSULE FSTORE:BRUSH
// Hind legs: rounded thigh, angled hock, slim cannon.
4 FSTORE:RADIUS
MAT_COOL_WHITE FSTORE:MATERIAL
26 29 23 VEC VSTORE:START
25 23 25 VEC VSTORE:END
STROKE:SWAP
3 FSTORE:RADIUS
VEC VSTORE:END
STROKE:SWAP
2 FSTORE:RADIUS
VEC VSTORE:END
STROKE

// Forelegs emerge from the shoulder, leaving daylight under the belly.
3 FSTORE:RADIUS
MAT_WHITE FSTORE:MATERIAL
25 29 39 VEC VSTORE:START
VEC VSTORE:END
STROKE:SWAP
2 FSTORE:RADIUS
VEC VSTORE:END
STROKE

// Lavender hooves and pale coronets.
BOX FSTORE:BRUSH
MAT_LAVENDER FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_COOL_WHITE FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
VEC VSTORE:START
VEC VSTORE:END
STROKE


JUMPIF done
// Move the first legs to the other side; the mirrored body stays unchanged.
VLOAD:CLIP_MIN VSTORE:START
VLOAD:CLIP_MAX VSTORE:END
FLIP:X
1 JUMPIF leg_pose
done:
