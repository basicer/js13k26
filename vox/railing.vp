// High-resolution tubular steel guardrail. Repeat along X.
SIZE_128 64 16 VEC SIZE
CAPSULE FSTORE:BRUSH
2 FSTORE:RADIUS
MAT_STEEL_11 FSTORE:MATERIAL
0 0 8 VEC VSTORE:START
0 61 8 VEC VSTORE:END
STROKE
MIRROR:X
0 31 8 VEC VSTORE:START
127 31 8 VEC VSTORE:END
STROKE
MAT_DEBUG_YELLOW FSTORE:MATERIAL
0 61 8 VEC VSTORE:START
127 61 8 VEC VSTORE:END
STROKE
// Consume stripe coordinates until the stack is empty.
SPHERE FSTORE:BRUSH
3 FSTORE:RADIUS
MAT_INK FSTORE:MATERIAL
60 52 44 36 28 20 12 4
stripe:
61 8 VEC VSTORE:START
STROKE:PAINT
FORJUMP stripe
MIRROR:X
