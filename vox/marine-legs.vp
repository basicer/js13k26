// Fatigues fill out the legs beneath separate knee and shin guards.
CAPSULE FSTORE:BRUSH
3 FSTORE:RADIUS
MAT_OLIVE_5 FSTORE:MATERIAL
VEC VSTORE:START
25 34 30 VEC VSTORE:END
STROKE
5 FSTORE:RADIUS
MAT_OLIVE_12 FSTORE:MATERIAL
25 28 30 VEC VSTORE:START
25 34 30 VEC VSTORE:END
STROKE
3 FSTORE:RADIUS
VEC VSTORE:START
VEC VSTORE:END
STROKE
SPHERE FSTORE:BRUSH
MAT_OLIVE_9 FSTORE:MATERIAL
VEC VSTORE:START
STROKE
BOX FSTORE:BRUSH
MAT_OLIVE_16 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE:PAINT
VEC VSTORE:START
VEC VSTORE:END
STROKE:PAINT

// Leather combat boots and reinforced toes sit above dark rubber soles.
MAT_LEATHER_3 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_LEATHER_5 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_LEATHER_7 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_BLACK_1 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE



JUMPIF done
VLOAD:CLIP_MIN VSTORE:START
VLOAD:CLIP_MAX VSTORE:END
FLIP:X
1 JUMPIF pose
done:
