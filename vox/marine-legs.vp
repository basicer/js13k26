// Marine legs. P0 swaps forward/lifted and rear/planted feet between sides.
// Stack: second exit flag, second pose, first exit flag, first pose.
LOADP:0 JUMPIF phase_one
1 0 0 1
1 JUMPIF pose
phase_one:
1 1 0 0
pose:
JUMPIF forward
// Lower-leg coordinates, stacked in reverse drawing order.
26 3 38
17 2 23
25 7 38
18 5 36
25 10 37
18 5 32
26 10 35
17 3 23
22 19 32
20 12 30
24 25 34
20 22 33
22 23 30
22 19 29
21 11 28
21 9 27
1 JUMPIF draw
forward:
26 5 44
17 4 29
25 9 44
18 7 42
25 12 43
18 7 38
26 12 41
17 5 29
22 19 38
20 12 36
24 25 40
20 22 39
22 23 36
22 19 35
21 13 34
21 11 33
draw:
// Flexible leg joints sit behind separate thigh, knee, and shin plates.
CAPSULE FSTORE:BRUSH
3 FSTORE:RADIUS
MAT_BLACK_3 FSTORE:MATERIAL
VEC VSTORE:START
23 34 30 VEC VSTORE:END
STROKE
4 FSTORE:RADIUS
MAT_OLIVE_12 FSTORE:MATERIAL
23 28 30 VEC VSTORE:START
23 34 30 VEC VSTORE:END
STROKE
MAT_OLIVE_10 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
SPHERE FSTORE:BRUSH
4 FSTORE:RADIUS
MAT_OLIVE_16 FSTORE:MATERIAL
VEC VSTORE:START
STROKE
BOX FSTORE:BRUSH
MAT_OLIVE_20 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE:PAINT
MAT_OLIVE_16 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE:PAINT

// Wide boots, forward toe caps, and dark soles anchor the stance.
MAT_GUNMETAL_1 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_OLIVE_9 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_STEEL_5 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE
MAT_BLACK_1 FSTORE:MATERIAL
VEC VSTORE:START
VEC VSTORE:END
STROKE



JUMPIF done
VLOAD:CLIP_MIN VSTORE:START
VLOAD:CLIP_MAX VSTORE:END
FLIP:X
1 JUMPIF pose
done:
